      "tags": ["文本", "编辑", "系统"],
      "kind": "Executable",
      "path": "%windir%\\System32\\notepad.exe"
    },
    {
      "id": "calc",
      "name": "计算器",
      "description": "Windows 计算器，支持标准与科学计算模式",
      "category": "工具/计算",
      "tags": ["计算", "数学", "系统"],
      "kind": "Executable",
      "path": "%windir%\\System32\\calc.exe"
    },
    {
      "id": "cmd",
      "name": "命令提示符",
      "description": "Windows 命令行终端，执行 DOS 命令和批处理脚本",
