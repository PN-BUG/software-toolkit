<Window x:Class="SoftwareToolkit.SoftwareInventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件清单" Width="1120" Height="740" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F2F6F3"
        FontFamily="Microsoft YaHei UI" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#34433C"/>
            <Setter Property="BorderBrush" Value="#CCDAD2"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#EAF3EE"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#DDEBE4"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#167D6B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#167D6B"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#106B5B"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Border" Property="Background" Value="#0D574B"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Border" Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GridText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Foreground" Value="#304038"/><Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F5F8F6"/><Setter Property="Foreground" Value="#65736C"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,9"/><Setter Property="BorderBrush" Value="#E0E9E4"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinHeight" Value="46"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F8F4"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#EDF2EF"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="5"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="软件清单" FontSize="26" FontWeight="Bold" Foreground="#20312A"/>
                <TextBlock Text="扫描本机软件，挑选要保留或分享的应用，并维护可用的下载入口。" Foreground="#69786F" FontSize="13" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Content="↻ 重新扫描" Style="{StaticResource ActionButton}" Click="Scan_Click"/>
                <Button Content="复制分享文本" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="CopyShareText_Click"/>
                <Button Content="导出分享页" Style="{StaticResource PrimaryActionButton}" Margin="8,0,0,0" Click="ExportHtml_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#DDE8E2" BorderThickness="1" CornerRadius="10" Padding="12,9" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ListTitleBox" BorderThickness="0" Background="Transparent" FontSize="14" FontWeight="SemiBold"
                         Foreground="#293A32" VerticalContentAlignment="Center" Text="我的软件清单" LostFocus="ListTitleBox_LostFocus"/>
                <Border Grid.Column="2" BorderBrush="#D7E2DC" BorderThickness="1" CornerRadius="7" Background="#F8FAF9" Padding="9,5">
                    <DockPanel><TextBlock Text="⌕" Foreground="#809087" FontSize="15" Margin="0,0,7,0"/>
                        <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="13"
                                 VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="搜索名称、发布者或版本"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE8E2" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_SelectionChanged">
                <TabItem>
                    <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="设备软件"/><Border Background="#E2F1E9" CornerRadius="8" Padding="7,1" Margin="7,0,0,0"><TextBlock x:Name="InventoryCountText" Text="0" Foreground="#167D6B" FontSize="11"/></Border></StackPanel></TabItem.Header>
                    <Grid>
                        <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended" SelectionUnit="FullRow"
                                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="加入" Width="58">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Click="Include_Click" ToolTip="加入或移出我的清单"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="软件" Width="2.2*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Margin="4,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#26372F" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PublisherDisplay}" FontSize="11" Foreground="#839087" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="版本" Binding="{Binding VersionDisplay}" Width="1.05*" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="1.25*" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="安装日期" Binding="{Binding InstallDate}" Width="1.0*" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTextColumn Header="包 ID" Binding="{Binding PackageId}" Width="1.5*" ElementStyle="{StaticResource GridText}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="LoadingOverlay" Background="#DDF7FAF8" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="210" Height="5" Foreground="#167D6B"/>
                                <TextBlock Text="正在扫描注册表、Store 应用并匹配 WinGet…" Foreground="#50625A" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="我的清单"/><Border Background="#E2F1E9" CornerRadius="8" Padding="7,1" Margin="7,0,0,0"><TextBlock x:Name="ListCountText" Text="0" Foreground="#167D6B" FontSize="11"/></Border></StackPanel></TabItem.Header>
                    <Grid>
                        <DataGrid x:Name="ListGrid" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionUnit="FullRow" CanUserAddRows="False"
                                  CanUserDeleteRows="False" CanUserReorderColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="软件" Width="245"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Margin="4,3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#26372F" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding PublisherDisplay}" FontSize="11" Foreground="#839087" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="版本" Binding="{Binding VersionDisplay}" Width="95" ElementStyle="{StaticResource GridText}"/>
                                <DataGridTemplateColumn Header="下载链接（可直接修改）" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding DownloadUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderBrush="#D5E1DA" BorderThickness="1" Padding="7,5"
                                                 FontSize="12" VerticalContentAlignment="Center" LostFocus="DownloadUrlBox_LostFocus"/>
                                        <TextBlock Grid.Column="1" Text="{Binding LinkModeDisplay}" FontSize="10" Foreground="#7B8A82" VerticalAlignment="Center" Margin="8,0,2,0"/>
                                    </Grid>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="操作" Width="205"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="下载" Style="{StaticResource PrimaryActionButton}" Height="29" Padding="12,0" Click="Download_Click"/>
                                        <Button Content="恢复自动" Style="{StaticResource ActionButton}" Height="29" Padding="10,0" Margin="6,0,0,0" Click="ResetAutoLink_Click"/>
                                        <Button Content="移除" Style="{StaticResource ActionButton}" Height="29" Padding="9,0" Margin="6,0,0,0" Click="Remove_Click"/>
                                    </StackPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="EmptyListPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="＋" FontSize="36" Foreground="#A5B6AD" HorizontalAlignment="Center"/>
                            <TextBlock Text="清单还是空的" FontSize="16" FontWeight="SemiBold" Foreground="#53645B" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Text="到“设备软件”中勾选要加入的应用" FontSize="12" Foreground="#8A9890" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="3" Margin="2,12,2,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="准备扫描" Foreground="#6F7E76" FontSize="12" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="选择当前结果" Style="{StaticResource ActionButton}" Height="30" Padding="11,0" Click="SelectVisible_Click"/>
                <Button Content="清空清单" Style="{StaticResource ActionButton}" Height="30" Padding="11,0" Margin="7,0,0,0" Click="ClearList_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
