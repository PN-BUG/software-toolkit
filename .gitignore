# ============================================
#  SoftwareToolkit .gitignore
# ============================================

# --- .NET Build Outputs ---
bin/
obj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# --- Legacy publish output ---
publish/

# --- Release packages (generated by build.ps1) ---
/release/
/.android-build/
/.build-keys/
/.gradle-local/

# --- NuGet ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
packages/

# --- Visual Studio ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user
*.DotSettings

# --- VS Code ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# --- Rider ---
.idea/
*.sln.iml

# --- Windows ---
Thumbs.db
Desktop.ini
[Dd]esktop.ini

# --- Logs & Temp ---
*.log
*.tmp
*.swp
*.cache
*.pid

# --- OS ---
.DS_Store
.AppleDouble
.LSOverride
Icon

# --- Test Results ---
TestResults/
*.trx
*.coverage
*.coveragexml

# --- Memory / AI agent files ---
/memories/

# --- Project-specific ---
*.orig
*.bak
