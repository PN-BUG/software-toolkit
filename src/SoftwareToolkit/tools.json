      "tags": ["终端", "命令行", "开发"],
      "kind": "Executable",
      "path": "%windir%\\System32\\cmd.exe"
    },
    {
      "id": "powershell",
      "name": "PowerShell",
      "description": "Windows PowerShell 终端，强大的脚本和自动化环境",
