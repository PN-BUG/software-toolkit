<Window x:Class="SoftwareToolkit.BuildOutputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编译输出" Height="500" Width="680"
        WindowStartupLocation="CenterOwner"
        MinHeight="300" MinWidth="450"
        Background="#1E1E2E"
        FontFamily="Microsoft YaHei UI"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部状态栏 -->
        <Border Grid.Row="0" Background="#181825" Padding="16,10"
                BorderBrush="#313244" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIcon" Text="⏳" FontSize="16" Margin="0,0,8,0"/>
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" Text="正在编译..."
                                   FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                        <TextBlock x:Name="StatusDetail" Text=""
                                   FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="OpenExeBtn" Content="📂 打开 EXE"
                            Visibility="Collapsed" Padding="10,4" FontSize="12"
                            Click="OpenExe_Click" Cursor="Hand"
                            Style="{StaticResource PrimaryButton}" Height="28"/>
                    <Button x:Name="OpenFolderBtn" Content="📁 打开目录"
                            Visibility="Collapsed" Padding="10,4" FontSize="12"
                            Margin="6,0,0,0" Click="OpenFolder_Click" Cursor="Hand"
                            Style="{StaticResource SecondaryButton}" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 输出文本 -->
        <Border Grid.Row="1" Margin="0">
            <TextBox x:Name="OutputBox"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Background="#1E1E2E"
                     Foreground="#A6ADC8"
                     FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                     FontSize="12"
                     Padding="12,8"/>
        </Border>

        <!-- 底栏 -->
        <Border Grid.Row="2" Background="#181825" Padding="16,8"
                BorderBrush="#313244" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ElapsedText" Text="" FontSize="11"
                           Foreground="#6C7086" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Content="取消" Padding="14,0"
                            Click="Cancel_Click" Cursor="Hand"
                            Style="{StaticResource SecondaryButton}" Height="28"/>
                    <Button x:Name="CloseBtn" Content="关闭" Padding="14,0"
                            Margin="6,0,0,0" Click="Close_Click"
                            Style="{StaticResource PrimaryButton}" Height="28"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
