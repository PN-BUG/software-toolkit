<UserControl x:Class="SoftwareToolkit.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F0F2F5"
             FontFamily="Microsoft YaHei UI">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E1E2E"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#585B70"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CardBox" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.06" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="White" Padding="24,20"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel>
                    <TextBlock Text="⚙️ 设置" FontSize="22" FontWeight="Bold" Foreground="#1E1E2E"/>
                    <TextBlock Text="自定义 SoftwareToolkit 的行为和外观" FontSize="12"
                               Foreground="#6C7086" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="✕" Width="32" Height="32" FontSize="14"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        Foreground="#585B70"
                        Click="Close_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E6E9F0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 设置内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      BorderThickness="0" Padding="24,20">
            <StackPanel>

                <!-- 全局热键 -->
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock Text="⌨️ 全局热键" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="设置显示/隐藏主窗口的快捷键"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="#D0D0D0" BorderThickness="1"
                                    CornerRadius="6" Background="White" Padding="10,6">
                                <TextBox x:Name="HotKeyBox" FontSize="14"
                                         BorderThickness="0" Background="Transparent"
                                         Padding="0" Text="Ctrl+Alt+T"/>
                            </Border>
                            <Button Grid.Column="1" Content="恢复默认" Margin="8,0,0,0"
                                    Padding="12,4" FontSize="12"
                                    Click="ResetHotKey_Click"
                                    Style="{StaticResource SecondaryButton}" Height="30"/>
                        </Grid>
                        <TextBlock x:Name="HotKeyHint" FontSize="11"
                                   Foreground="#9CA0B0" Margin="0,6,0,0">
                            支持组合: Ctrl, Alt, Shift, Win + A~Z / F1~F12
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 界面语言 -->
                <Border Style="{StaticResource CardBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🌐 界面语言" Style="{StaticResource SectionTitle}" Margin="0,0,0,3"/>
                            <TextBlock Text="选择应用显示语言，保存后立即生效"
                                       FontSize="11" Foreground="#9CA0B0"/>
                        </StackPanel>
                        <ComboBox x:Name="LanguageCombo" Grid.Column="1" Height="34"
                                  VerticalContentAlignment="Center" Padding="10,0"
                                  BorderBrush="#D0D0D0" Background="White">
                            <ComboBoxItem Content="中文" Tag="zh-CN"/>
                            <ComboBoxItem Content="English" Tag="en-US"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- 行为 -->
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock Text="🎯 行为" Style="{StaticResource SectionTitle}"/>
                        <CheckBox x:Name="AutoStartChk" FontSize="13"
                                  Foreground="#1E1E2E" Margin="0,4,0,0"
                                  Content="开机自动启动 SoftwareToolkit"
                                  Checked="AutoStartOption_Changed"
                                  Unchecked="AutoStartOption_Changed"/>
                        <TextBlock FontSize="11" Foreground="#9CA0B0"
                                   Margin="24,4,0,0">
                            启用后，系统启动时自动运行本程序（注册表 Run 项）
                        </TextBlock>
                        <CheckBox x:Name="MinimizeToTrayChk" FontSize="13"
                                  Foreground="#1E1E2E" Margin="0,12,0,0"
                                  Content="关闭窗口时最小化到系统托盘（而非退出）"
                                  Checked="MinimizeOption_Changed"
                                  Unchecked="MinimizeOption_Changed"/>
                        <TextBlock FontSize="11" Foreground="#9CA0B0"
                                   Margin="24,4,0,0">
                            启用后，点击 ❌ 会隐藏到托盘图标，右键托盘图标可选择退出
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource CardBox}">
                    <StackPanel>
                        <TextBlock Text="ℹ️ 关于" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="应用:" Foreground="#585B70" Grid.Row="0" Grid.Column="0" FontSize="12"/>
                            <TextBlock Text="SoftwareToolkit" Foreground="#1E1E2E" Grid.Row="0" Grid.Column="1" FontSize="12"/>
                            <TextBlock Text="版本:" Foreground="#585B70" Grid.Row="1" Grid.Column="0" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock x:Name="VersionText" Text="1.0.0" Foreground="#1E1E2E" Grid.Row="1" Grid.Column="1" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock Text="配置:" Foreground="#585B70" Grid.Row="2" Grid.Column="0" FontSize="12" Margin="0,4,0,0"/>
                            <TextBlock x:Name="ConfigPathText" Text="" Foreground="#1E1E2E" Grid.Row="2" Grid.Column="1" FontSize="11" Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Separator Margin="0,12,0,8" Background="#E0E0E0"/>
                        <StackPanel>
                            <Button x:Name="UninstallBtn" Content="🗑️ 卸载 SoftwareToolkit"
                                    FontSize="12" Foreground="#D20F39"
                                    Background="#FEEBEC" BorderBrush="#F38BA8"
                                    BorderThickness="1"
                                    Padding="12,6" Height="32" Cursor="Hand"
                                    HorizontalAlignment="Left"
                                    Click="Uninstall_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FDDAD9"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#FBB8B8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <TextBlock FontSize="11" Foreground="#9CA0B0"
                                       Margin="0,4,0,0">
                                删除所有文件、配置和注册表项，彻底移除本程序
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底栏按钮 -->
        <Border Grid.Row="2" Background="White" Padding="24,16"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="取消" Padding="16,0"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}"/>
                <Button Content="保存" Padding="16,0"
                        Margin="8,0,0,0"
                        Click="Save_Click"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
