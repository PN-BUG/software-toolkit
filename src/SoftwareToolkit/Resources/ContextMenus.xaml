<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WorkbenchMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="#304B40"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Border x:Name="Row" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Icon" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="10" Foreground="#91A497" VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#E8F3EC"/><Setter Property="Foreground" Value="#167D6B"/></Trigger>
                <Trigger Property="Tag" Value="Danger"><Setter Property="Foreground" Value="#B65448"/></Trigger>
                <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="Danger"/><Condition Property="IsHighlighted" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Row" Property="Background" Value="#FBECE8"/></MultiTrigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.38"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WorkbenchContextMenu" TargetType="ContextMenu">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="MinWidth" Value="248"/>
        <Setter Property="MaxWidth" Value="360"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="#FFFFFF" BorderBrush="#D7E5DB" BorderThickness="1" CornerRadius="12" Padding="7">
                <StackPanel KeyboardNavigation.DirectionalNavigation="Cycle">
                    <TextBlock Text="{TemplateBinding Tag}" Foreground="#7C9284" FontFamily="Microsoft YaHei UI" FontSize="11" FontWeight="SemiBold" Margin="10,7,10,10" TextTrimming="CharacterEllipsis"/>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
                </StackPanel>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Resources>
            <Style TargetType="Separator">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Margin="10,6" Background="#E8EEE9"/></ControlTemplate></Setter.Value></Setter>
            </Style>
        </Style.Resources>
    </Style>
</ResourceDictionary>
