<Window x:Class="SoftwareToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SoftwareToolkit"
        xmlns:models="clr-namespace:SoftwareToolkit.Models"
        xmlns:services="clr-namespace:SoftwareToolkit.Services"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="SoftwareToolkit · 工具工作台" Width="1220" Height="830" MinWidth="860" MinHeight="620"
        FontFamily="Microsoft YaHei UI" FontSize="13" Foreground="#243B39" Background="#F7F9F9"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="/SoftwareToolkit;component/Resources/icon.ico" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" StateChanged="Window_StateChanged" Loaded="Window_Loaded"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="TextPrimary" Color="#243B39"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#758580"/>
        <sys:Double x:Key="ToolCardWidth">286</sys:Double>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <services:KindToIconConverter x:Key="KindToIconConverter"/>
        <services:KindToLabelConverter x:Key="KindToLabelConverter"/>
        <services:CategoryToColorConverter x:Key="CategoryToColorConverter"/>
        <services:BatchModeVisibilityConverter x:Key="BatchModeVisibilityConverter"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#425A53"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DBE5E1"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/><Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/><Setter TargetName="Surface" Property="BorderBrush" Value="#168575"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.55"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#168575"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#167D6B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#167D6B"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Height" Value="30"/><Setter Property="Width" Value="30"/><Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Batch"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ToolActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Batch"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FavoriteButton" TargetType="Button" BasedOn="{StaticResource SmallButton}">
            <Setter Property="Content" Value="☆"/><Setter Property="FontSize" Value="21"/>
            <Setter Property="ToolTip" Value="收藏工具"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True">
                <Setter Property="Content" Value="★"/><Setter Property="Foreground" Value="#AC761D"/><Setter Property="ToolTip" Value="取消收藏"/>
            </DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="CategoryTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="#677C73"/><Setter Property="Padding" Value="12,11"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
                <StackPanel>
                    <Border x:Name="Row" CornerRadius="8" Margin="0,2" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <DockPanel>
                            <ToggleButton x:Name="Expander" DockPanel.Dock="Right" Width="18" Background="Transparent" BorderThickness="0" Foreground="#849A90" Content="›"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <ItemsPresenter x:Name="Children" Margin="14,0,0,0"/>
                </StackPanel>
                <ControlTemplate.Triggers>
                    <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="IsExpanded" Value="False"><Setter TargetName="Children" Property="Visibility" Value="Collapsed"/></Trigger>
                    <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Expander" Property="Content" Value="⌄"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#E6EEEA"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="White"/><Setter Property="Foreground" Value="#167D6B"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ToolSurface" TargetType="Border">
            <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E0E8E4"/><Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#83BAA9"/><Setter Property="Background" Value="#FCFEFD"/></Trigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="BorderBrush" Value="#168575"/><Setter Property="Background" Value="#F0F8F4"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SortControl" TargetType="ComboBox">
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,8"/></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border CornerRadius="7" Background="White" BorderBrush="#DBE5E1" BorderThickness="1"/>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="12,0,26,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#789386" IsHitTestVisible="False"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="White" BorderBrush="#DCE7DF" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type models:ToolDefinition}">
            <Border Width="{DynamicResource ToolCardWidth}" Height="194" Padding="18">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ToolSurface}"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=CardBatchCheck}" Value="True"><Setter Property="Background" Value="#E4F3EA"/><Setter Property="BorderBrush" Value="#168575"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" HorizontalAlignment="Left" Background="{Binding Category, Converter={StaticResource CategoryToColorConverter}}">
                            <TextBlock Text="{Binding Kind, Converter={StaticResource KindToIconConverter}}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#294C42"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding Kind, Converter={StaticResource KindToLabelConverter}}" FontSize="10" Foreground="#83958C" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource FavoriteButton}" Tag="{Binding}" Click="Favorite_Click"/>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="#788981" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" VerticalAlignment="Top" Margin="0,16,0,10" ToolTip="{Binding Description}"/>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="#81948A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="启动  ↗" Height="30" Padding="10,0" Style="{StaticResource ToolActionButton}" Tag="{Binding}" Click="LaunchButton_Click"/>
                        <Button Grid.Column="2" Content="···" FontWeight="Bold" Margin="4,0,0,0" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="MoreButton_Click" ToolTip="编辑、打开位置与其他操作"/>
                    </Grid>
                    <CheckBox x:Name="CardBatchCheck" Grid.RowSpan="3" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="-13,-13,0,0" Background="White"
                              Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BatchModeVisibilityConverter}}"
                              Loaded="BatchCheckBox_Loaded" DataContextChanged="BatchCheckBox_DataContextChanged" Checked="BatchCheckBox_Checked" Unchecked="BatchCheckBox_Unchecked"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ListTemplate" DataType="{x:Type models:ToolDefinition}">
            <Border Padding="16,12">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ToolSurface}"><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=RowBatchCheck}" Value="True"><Setter Property="Background" Value="#E4F3EA"/><Setter Property="BorderBrush" Value="#168575"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="RowBatchCheck" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BatchModeVisibilityConverter}}"
                              Loaded="BatchCheckBox_Loaded" DataContextChanged="BatchCheckBox_DataContextChanged" Checked="BatchCheckBox_Checked" Unchecked="BatchCheckBox_Unchecked"/>
                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" HorizontalAlignment="Left" Background="{Binding Category, Converter={StaticResource CategoryToColorConverter}}">
                        <TextBlock Text="{Binding Kind, Converter={StaticResource KindToIconConverter}}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Margin="0,5,0,0" FontSize="11" Foreground="#81948A" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Category}" VerticalAlignment="Center" FontSize="11" Foreground="#81948A" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource FavoriteButton}" Tag="{Binding}" Click="Favorite_Click" Margin="0,0,8,0"/>
                        <Button Content="启动 ↗" Style="{StaticResource ToolActionButton}" Height="30" Tag="{Binding}" Click="LaunchButton_Click"/>
                        <Button Content="···" Style="{StaticResource SmallButton}" Tag="{Binding}" Click="MoreButton_Click" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#EDF3EF" BorderBrush="#E0E8E1" BorderThickness="0,0,1,0">
            <Grid Margin="14,0">
                <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                    <Border Background="#167D6B" CornerRadius="10" Width="36" Height="36"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel Margin="10,0,0,0"><TextBlock Text="工具工作台" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="SOFTWARE TOOLKIT" FontSize="9" Foreground="#81958A" Margin="0,4,0,0"/></StackPanel>
                </StackPanel>
                <TreeView Grid.Row="1" x:Name="CategoryTree" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource CategoryTreeItem}" SelectedItemChanged="CategoryTree_SelectedItemChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <StackPanel Grid.Row="2" Margin="4,18">
                    <Border BorderBrush="#D5E2D9" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,16">
                        <StackPanel><TextBlock Text="把工具放在顺手的地方" FontSize="11" Foreground="#536F60"/><TextBlock Text="拖入文件即可添加" FontSize="10" Foreground="#92A197" Margin="0,6,0,0"/></StackPanel>
                    </Border>
                    <Button x:Name="SettingsBtn" Content="设置与偏好" Style="{StaticResource ActionButton}" Background="Transparent" Click="SettingsBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#E7EDE9" BorderThickness="0,0,0,1" Padding="26,18">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="SearchBorder" Background="#F5F8F6" BorderBrush="#DFE8E2" BorderThickness="1" CornerRadius="9" HorizontalAlignment="Stretch">
                        <Grid>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#789386" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" AutomationProperties.Name="搜索工具" Padding="38,9,42,9" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"/>
                            <TextBlock Text="搜索名称、标签、描述…" FontSize="12" Foreground="#8C9C92" VerticalAlignment="Center" Margin="38,0,60,0" IsHitTestVisible="False" Visibility="{Binding Text.IsEmpty, ElementName=SearchBox, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="×" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" Margin="0,0,6,0" Click="ClearSearch_Click" ToolTip="清空搜索 · Esc"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="1" Content="＋  添加工具" Style="{StaticResource AccentButton}" Margin="18,0,0,0" Height="42" Click="AddToolBtn_Click"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="30,26,30,14">
                <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="我的工作空间 / 工具库" FontSize="11" Foreground="#8A9A90" Margin="0,0,0,8"/><TextBlock x:Name="CollectionTitle" Text="全部工具" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ResultCountText" Text="正在加载工具" FontSize="12" Foreground="#85958A" Margin="0,7,0,0"/></StackPanel>
                    <Button Grid.Column="1" x:Name="RefreshBtn" Content="刷新" Style="{StaticResource ActionButton}" VerticalAlignment="Bottom" Click="RefreshBtn_Click" ToolTip="重新扫描工具 · F5"/>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="排序" VerticalAlignment="Center" Foreground="#7E9285" Margin="0,0,10,0"/>
                        <ComboBox x:Name="SortBox" Style="{StaticResource SortControl}" Width="132" Height="32" SelectedIndex="0" SelectionChanged="SortBox_SelectionChanged" VerticalContentAlignment="Center" Padding="10,3" AutomationProperties.Name="排序方式">
                            <ComboBoxItem Content="常用优先"/><ComboBoxItem Content="名称 A → Z"/><ComboBoxItem Content="最近使用"/><ComboBoxItem Content="收藏优先"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BatchModeBtn" Content="多选" Style="{StaticResource ActionButton}" Click="BatchModeBtn_Click" Margin="0,0,10,0"/>
                        <Button x:Name="LayoutToggleBtn" Content="切换列表" Style="{StaticResource ActionButton}" Click="ToggleLayout_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <Grid Grid.Row="2" Margin="24,0,24,12">
                <ListBox x:Name="ToolCardsListBox" Background="Transparent" BorderThickness="0" Padding="0"
                         SizeChanged="ToolList_SizeChanged" SelectionChanged="ToolList_SelectionChanged" MouseDoubleClick="ToolList_MouseDoubleClick"
                         PreviewMouseLeftButtonUp="ToolCardsListBox_PreviewMouseLeftButtonUp" PreviewMouseRightButtonUp="ToolCardsListBox_PreviewMouseRightButtonUp"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                </ListBox>
                <Border x:Name="EmptyOverlay" Visibility="Collapsed" Background="#F7F9F9">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#A5BDB0" HorizontalAlignment="Center"/>
                        <TextBlock Text="这里还没有工具" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,10"/>
                        <TextBlock x:Name="EmptySubText" Text="添加一个工具，开始整理你的工作空间。" TextWrapping="Wrap" TextAlignment="Center" Foreground="#84988A"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <Button Content="清除筛选" Style="{StaticResource ActionButton}" Click="ResetFilters_Click" Margin="0,0,10,0"/>
                            <Button Content="添加工具" Style="{StaticResource AccentButton}" Click="AddToolBtn_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <Grid Grid.Row="3" Margin="30,0,30,12">
                <Border x:Name="SelectionPanel" Background="White" BorderBrush="#D9E6DE" BorderThickness="1" CornerRadius="10" Padding="16,12" Visibility="Collapsed">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0"><TextBlock x:Name="SelectedNameText" FontWeight="SemiBold"/><TextBlock x:Name="SelectedPathText" Foreground="#829789" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="编辑" Style="{StaticResource ActionButton}" Click="SelectedEdit_Click" Margin="0,0,10,0"/>
                            <Button Content="启动工具  ↗" Style="{StaticResource AccentButton}" Click="SelectedLaunch_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="BatchBar" Visibility="Collapsed" Background="#E7F3ED" BorderBrush="#BFDACC" BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="BatchPinButton" Content="收藏" Style="{StaticResource ActionButton}" Click="BatchPin_Click" Margin="0,0,8,0"/>
                            <Button x:Name="BatchDeleteButton" Content="删除" Foreground="#BB5F50" Style="{StaticResource ActionButton}" Click="BatchDelete_Click" Margin="0,0,8,0"/>
                            <Button Content="完成" Style="{StaticResource AccentButton}" Click="BatchCancel_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="BatchSelectAllCheck" Content="全选" Checked="BatchSelectAll_Checked" Unchecked="BatchSelectAll_Unchecked" VerticalAlignment="Center"/><TextBlock x:Name="BatchCountText" Text="已选择 0 个" Margin="14,0,0,0" VerticalAlignment="Center"/></StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <DockPanel Grid.Row="4" Margin="30,0">
                <TextBlock DockPanel.Dock="Right" Text="Ctrl+F 搜索  ·  双击 / Enter 启动" FontSize="10" Foreground="#98A69D"/>
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="10" Foreground="#7A9182" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
        <Grid x:Name="SettingsOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="100">
            <Border x:Name="SettingsBackdrop" Background="#80000000" Opacity="0" MouseLeftButtonDown="SettingsBackdrop_MouseLeftButtonDown"/>
            <Border x:Name="SettingsSlidePanel" Width="480" HorizontalAlignment="Right" Background="#F0F2F5" RenderTransformOrigin="1,0">
                <Border.RenderTransform><TranslateTransform X="480"/></Border.RenderTransform>
                <ContentControl x:Name="SettingsPanelHost"/>
            </Border>
        </Grid>
    </Grid>
</Window>
